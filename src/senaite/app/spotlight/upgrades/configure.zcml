<?xml version="1.0" encoding="utf-8"?>
<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup">

  <genericsetup:upgradeStep
      title="Upgrade SENAITE APP SPOTLIGHT"
      description="Version 2.7.0: Drop the empty-cell sentinel from the
                   stored spotlight command rows"
      source="2703"
      destination="2704"
      handler="senaite.app.spotlight.upgrades.handlers.to_2704"
      profile="senaite.app.spotlight:default" />

  <genericsetup:upgradeStep
      title="Upgrade SENAITE APP SPOTLIGHT"
      description="Version 2.7.0: Backfill the 'show_for_clients' flag so the
                   lab-only catalogs are hidden from client contacts"
      source="2702"
      destination="2703"
      handler="senaite.app.spotlight.upgrades.handlers.to_2703"
      profile="senaite.app.spotlight:default" />

  <genericsetup:upgradeStep
      title="Upgrade SENAITE APP SPOTLIGHT"
      description="Version 2.7.0: Add the internal catalogs as disabled rows
                   to the spotlight catalog list"
      source="2701"
      destination="2702"
      handler="senaite.app.spotlight.upgrades.handlers.to_2702"
      profile="senaite.app.spotlight:default" />

  <genericsetup:upgradeStep
      title="Upgrade SENAITE APP SPOTLIGHT"
      description="Version 2.7.0: React based spotlight search with control
                   panel configuration"
      source="2700"
      destination="2701"
      handler="senaite.app.spotlight.upgrades.handlers.to_2701"
      profile="senaite.app.spotlight:default" />

  <genericsetup:upgradeStep
      title="Upgrade SENAITE APP SPOTLIGHT"
      description="Version 2.7.0"
      source="2600"
      destination="2700"
      handler="senaite.app.spotlight.upgrades.handlers.to_2700"
      profile="senaite.app.spotlight:default" />

  <genericsetup:upgradeStep
      title="Upgrade SENAITE APP SPOTLIGHT"
      description="Version 2.6.0"
      source="2500"
      destination="2600"
      handler="senaite.app.spotlight.upgrades.handlers.to_2600"
      profile="senaite.app.spotlight:default" />

  <genericsetup:upgradeStep
      title="Upgrade SENAITE APP SPOTLIGHT"
      description="Version 2.5.0"
      source="2400"
      destination="2500"
      handler="senaite.app.spotlight.upgrades.handlers.to_2500"
      profile="senaite.app.spotlight:default" />

  <genericsetup:upgradeStep
      title="Upgrade SENAITE APP SPOTLIGHT"
      description="Version 2.4.0"
      source="2300"
      destination="2400"
      handler="senaite.app.spotlight.upgrades.handlers.to_2400"
      profile="senaite.app.spotlight:default" />

  <genericsetup:upgradeStep
      title="Upgrade SENAITE APP SPOTLIGHT"
      description="Version 2.3.0"
      source="*"
      destination="2300"
      handler="senaite.app.spotlight.upgrades.handlers.to_2300"
      profile="senaite.app.spotlight:default" />

</configure>
