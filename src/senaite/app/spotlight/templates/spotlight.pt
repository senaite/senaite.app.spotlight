<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      metal:use-macro="here/main_template/macros/master"
      i18n:domain="senaite.core">
  <body>
    <metal:title fill-slot="content-title"></metal:title>
    <metal:content fill-slot="content">
      <div class="text-center text-muted p-5" i18n:translate="">
        Opening spotlight search ...
      </div>
      <!-- The overlay itself is rendered by the spotlight viewlet. Here we
           only trigger it once the bundle has registered the global API. -->
      <script type="text/javascript">
      /* <![CDATA[ */
        (function () {
          var tries = 0;
          var timer = window.setInterval(function () {
            tries += 1;
            if (window.senaite && window.senaite.spotlight) {
              window.clearInterval(timer);
              window.senaite.spotlight.open();
            } else if (tries > 50) {
              window.clearInterval(timer);
            }
          }, 100);
        })();
      /* ]]> */
      </script>
    </metal:content>
  </body>
</html>
