<tal:spotlight i18n:domain="senaite.core">
  <!-- React mount node, the configuration is provided as JSON -->
  <div id="spotlight-root"
       tal:attributes="data-config view/get_config_json"></div>

  <!-- Spotlight bundle (consumes the shared React from senaite.core) -->
  <script
      src="#"
      type="text/javascript"
      tal:define="portal context/@@plone_portal_state/portal"
      tal:attributes="src string:${portal/absolute_url}/++resource++senaite.app.spotlight.static/js/senaite.app.spotlight.js">
  </script>
</tal:spotlight>
